      ],
      "title": "서울 임산부 교통비 지원",
      "providerId": "seoul-umppa",
      "canonicalUrl": "https://umppa.seoul.go.kr/hmpg/life/cycl/lifeCyclInfoDetail.do?sys_name=biz&doc_id=34B5EA8BEB354E2DB26136CFE52AEFF2",
      "region": "서울",
      "location": "서울시 · 온라인 또는 지정 신청처",
      "audience": "서울에 3개월 이상 계속 거주한 임산부 · 결혼이민자는 별도 조건 확인",
      "ageGroups": [],
      "applicationStart": null,
      "applicationEnd": null,
      "applicationMode": "relative",
      "applicationNote": "임신 확인 후부터 출산 후 6개월 이내 신청",
      "eventStart": null,
      "eventEnd": null,
      "feeStatus": "unknown",
      "feeText": "지원금·바우처 사업 · 지원 범위 밖 본인부담과 개별 이용요금은 공식 확인",
      "summary": "임산부 본인 명의 협약카드에70~100만원의 교통비 바우처를 지급합니다.",
      "conditions": [
        "2026/7/1 이후 신청은 서울시3개월 이상 계속 거주 조건이며 임신 확인 후~출산6개월 이내 신청합니다.부부 모두 외국인이면 제외됩니다.",
        "협약6개 카드사에서 임산부 본인 명의 신용·체크카드를 준비합니다.전용 국민행복카드는 지급 불가이며 지급 후 카드사를 바꿀 수 없습니다.",
        "임신 중 신청은 분만예정일,출산 후 신청은 출생일로부터12개월이 되는 달 말일까지 사용합니다.2026/3/30 이전 신청자는6개월 기준입니다.",
        "버스·지하철 후불교통은 사용전표가 종료일 이후 접수되면 자부담이며 복원되지 않습니다.서울 유류비 가맹점·코레일 공식 예매 등 사용처를 확인하세요.",
        "셀프주유소 선승인과 실제 승인의 합계보다 잔액이 적으면 자부담될 수 있습니다.신청시점·대상별 지급액과 서류를 확인하세요."
      ],
      "publicationStatus": "verified",
      "verifiedAt": "2026-10-26T07:15:46.246Z",
